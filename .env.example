# Copy these into your hosting service's "Environment" settings (never commit real values).
TURSO_URL=libsql://YOUR-DATABASE-NAME-YOUR-ORG.turso.io
TURSO_TOKEN=paste-a-NEW-database-token-here
SESSION_SECRET=any-long-random-text-at-least-32-characters
# Only used the very first time, when the database has no users yet (the desktop app's users are reused otherwise):
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=choose-a-strong-password
# Cloudflare R2 for scanned documents (optional but recommended):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=saireeyaa-documents
TIMEZONE=Asia/Colombo
